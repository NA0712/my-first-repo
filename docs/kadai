**④AIのコード**
  AIのコードと期待通りの結果を出してくれた
**⑤コードの説明**
def top_words(text):
    # 文章を空白で区切って、単語ごとにする
    words = text.split()

    # 単語が何回出てきたかを入れるための辞書を作る
    count = {}

    # 単語を1つずつ取り出す
    for word in words:
        # 大文字と小文字を同じものとして扱うために小文字にする
        word = word.lower()

        # その単語がすでに辞書にあるか確認する
        if word in count:
            # あったら、回数を1増やす
            count[word] = count[word] + 1
        else:
            # なかったら、回数を1にする
            count[word] = 1

    # 単語と回数を入れるリストを作る
    result = []

    # 辞書に入っている単語を1つずつ取り出す
    for word in count:
        # 単語とその回数をセットにしてリストに入れる
        result.append((word, count[word]))

    # 回数が多い順に並べる
    # 同じ回数の場合はアルファベット順にする
    result.sort(key=lambda x: (-x[1], x[0]))

    # 上から3つだけ取り出して返す
    return result[:3]


print(top_words("the cat and the hat and the bat"))
# [('the', 3), ('and', 2), ('bat', 1)]

print(top_words("Apple banana apple Cherry banana APPLE"))
# [('apple', 3), ('banana', 2), ('cherry', 1)]

print(top_words(""))
# []
**⑥上位ｎ件を返すコード**
  １行目のdef top_words(text):を、def top_words(text, n=3):に変える
  最後の行のreturn result[:3]をreturn result[:n]に変える
